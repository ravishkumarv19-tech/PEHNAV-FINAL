# ── Supabase (same project as the store) ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Security ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed admin email addresses
# Only these emails can ever log into this admin panel
VITE_ALLOWED_ADMIN_EMAILS=you@yourdomain.com,partner@yourdomain.com

# ── Store URL (for "View Store" link) ─────────────────────────────────────────
VITE_STORE_URL=https://pehnav.vercel.app
