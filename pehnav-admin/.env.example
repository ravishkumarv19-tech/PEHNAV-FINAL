# ============================================================
# PEHNAV Admin Panel — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Same Supabase project as the storefront
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Admin app runs on port 4000 to avoid conflict with storefront (3000)
# No other env vars needed — secrets live server-side in Supabase
