# Supabase — supabase.com → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (Supabase edge functions / Vercel API routes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay — dashboard.razorpay.com → Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# Resend — resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=orders@pehnav.com

# Claude AI — console.anthropic.com → API Keys
# Groq — FREE: 14,400 requests/day — SERVER-SIDE ONLY (never in the browser)
# Set this as a Supabase Edge Function secret, NOT as a VITE_ variable
# Run: supabase secrets set GROQ_API_KEY=gsk_...
# Get key at: console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App URL
VITE_APP_URL=http://localhost:3000
